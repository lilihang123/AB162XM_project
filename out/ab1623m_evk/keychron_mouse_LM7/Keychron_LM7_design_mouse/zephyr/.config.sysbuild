# sysbuild controlled configuration settings
CONFIG_ROM_END_OFFSET=0x1000
CONFIG_MCUBOOT_UPDATE_FOOTER_SIZE=0x1000
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUBOOT_SIGNATURE_KEY_FILE="/workdir/airoha/mcu/applications/mcuboot/private_secure_boot_3k.pem"
CONFIG_MCUBOOT_ENCRYPTION_KEY_FILE=""
CONFIG_MCUBOOT_GENERATE_UNSIGNED_IMAGE=y
