            port = <1>;
        };
        spim2: spim@400a0000 {
            compatible = "airoha,air-spim";
            reg = <0x400a0000 0x3c>;
            status = "okay";
            frequency = <1000000>;
            port = <2>;
        };
        spis: spis@400b0000 {
            compatible = "airoha,air-spis";
            reg = <0x400b0000 0xa4>;
            status = "okay";
