/ {
 #address-cells = <1>;
 #size-cells = <1>;
 chosen { };
 aliases { };
};
# 4 "/workdir/zephyr/dts/arm/armv8-m.dtsi" 2 3 4

/ {
 soc {
  #address-cells = <1>;
  #size-cells = <1>;
  compatible = "simple-bus";
  interrupt-parent = <&nvic>;
  ranges;

  nvic: interrupt-controller@e000e100 {
   #address-cells = <1>;
   compatible = "arm,v8m-nvic";
   reg = <0xe000e100 0xc00>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  systick: timer@e000e010 {
   compatible = "arm,armv8m-systick";
   reg = <0xe000e010 0x10>;
  };
 };
};
# 38 "/workdir/airoha/mcu/dts/arm/airoha/ab162x/ab162x_common.dtsi" 2 3 4


/ {

    chosen {
        zephyr,flash-controller = &flash_controller;
        zephyr,bt-hci = &airoha_hci;
    };

    aliases {
        flash-memory = &flash0;
        main-flash-partitions = &main_flash_partitions;




    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;

        cpu0: cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-m33f";
            cpu-power-states = <&state0 &state1>;
            reg = <0>;
        };
    };

    power-states {
        state0: state0 {
            compatible = "zephyr,power-state";
            power-state-name = "runtime-idle";
            substate-id = <1>;
            min-residency-us = <3000000>;
            exit-latency-us = <5000>;
        };
        state1: state1 {
            compatible = "zephyr,power-state";
            power-state-name = "suspend-to-ram";
            substate-id = <1>;
            min-residency-us = <3000000>;
            exit-latency-us = <20000>;
        };

    };

    soc {
        compatible = "simple-bus";


        tcm: memory@4000000 {
            compatible = "mmio-sram";
            reg = < 0x04000000 ((384) * 1024) >;
        };

        ram_bt: memory@4060000 {
            compatible = "mmio-sram";
            reg = < 0x04060000 ((16) * 1024) >;
        };

        riscv_sram: memory@84064000 {
            compatible = "mmio-sram";
            reg = < 0x84064000 ((24) * 1024) >;
        };

        misc_peripheral: misc@42010000 {
            compatible = "airoha,air-misc";
            reg = <
                0x42010000 0x804
                0x42020000 0x604
                0x42080000 0x90
                0x422E0000 0x28
                0x422F0000 0x1048
                0x42300000 0x10000
                0x42310000 0x10000
                0x40000000 0x10000
                0x43000000 0x10000
            >;
        };

        cm33_systick: timer@e000e010 {
            compatible = "arm,armv8m-systick";
            reg = < 0xe000e010 0x10 >;
            status = "disabled";
        };

        os_timer: ost@42170000 {
            compatible = "airoha,air-ost";
            reg = < 0x42170000 0x20 >;
            channel-num = < 1 >;
            clock-source = < 0 >;
            clock-divider = < 13 >;
            status = "okay";
        };

        wdt0: wdt0@42090000 {
            compatible = "airoha,air-wdt";
            reg = <0x42090000 0x28>;
            status = "okay";
        };

        wdt1: wdt1@42090030 {
            compatible = "airoha,air-wdt";
            reg = <0x42090030 0x28>;
            status = "okay";
        };

        cache_controller: cache@e0180000 {
            compatible = "airoha,air-cache";
            reg = <0xe0180000 0x80>;
            remap-channel-num = < 4 >;
            cacheable-channel-num = < 16 >;

            cache-memory-size = < 0x4000 >;
            icache-line-size = < 32 >;
            dcache-line-size = < 32 >;
            cacheable-region-alignment = < 0x1000 >;
            status = "okay";
        };

        flash_controller: flash-controller@40080000 {
            compatible = "airoha,air-flash-controller";



            reg = <0x40080000 0x48 0x40080800 0x100>;
            partial-erase;

            #address-cells = <1>;
            #size-cells = <1>;
            status = "okay";

            flash0: flash@8000000 {




                reg = <0x08000000 ((1024) * 1024)>;

                compatible = "soc-nv-flash";
                erase-block-size = <4096>;

                write-block-size = <1>;

                main_flash_partitions: partitions {
                    compatible = "airoha,air-flash-partitions", "fixed-partitions";
                    #address-cells = < 0x1 >;
                    #size-cells = < 0x1 >;
                };
            };
        };

        airoha_hci: airoha_hci{
            compatible = "airoha,air-bt-hci";
            status = "okay";
        };

        dma: dma@40040000 {
            compatible = "airoha,air-dma";
            reg = < 0x40040000 0x10000 >;
            mcu-dma-ch-num = <3>;
            slow-dma-ch-num = <16>;
            dma-ch-base = <
                0x40040000 0x42230000
                0x42270000 0x42280000 0x42290000
                0x42220000 0x400F0000
            >;
            dma-ch-length = <
                0x12C 0x12C
                0x270 0x270 0x270
                0x22C 0x22C 0x22C
            >;
            status = "okay";
        };

        esc: esc@40090000 {
            compatible = "airoha,air-esc";
            reg = < 0x40090000 0x10000 >;
            status = "okay";
        };

        irq_gen: irq_gen@422b0000 {
            compatible = "airoha,air-irq-gen";
            reg = < 0x422B0000 0x10 0x422C0000 0x10 >;
            status = "okay";
        };
        gpt: gpt@42150000{
            compatible = "airoha,air-gpt";
            reg = < 0x42150000 0xc18 >;
            status = "okay";
          };
        rtc: rtc@42100000{
            compatible = "airoha,air-rtc";
            reg = < 0x42100000 0xf1c >;
            status = "okay";
          };
        trng: trng@40030000 {
            compatible = "airoha,air-trng";
            reg = <0x40030000 0x1000>;
            status = "okay";
            von-neumann-extractor;
        };

        hw_semaphore: hw_semaphore@422a0000 {
            compatible = "airoha,air-hw-semaphore";
            reg = <0x422A0000 0x308>;
            channels = <32>;
            status = "okay";
        };


        i2c0: i2c@42210000 {
            compatible = "airoha,air-i2c";
            reg = <0x42210000 0xbc>;
            status = "okay";
            frequency = <1000000>;
            port = <0>;
        };
        i2c1: i2c@400e0000 {
            #address-cells = <1>;
            #size-cells = <0>;
            compatible = "airoha,air-i2c";
            reg = <0x400e0000 0xbc>;
            status = "okay";
            frequency = <1000000>;
            port = <1>;
        };
        gpio0: gpio@420b0000 {
            compatible = "airoha,air-gpio";
            gpio-controller;
            reg = <0x420b0000 0x44 0x420c0000 0x108 0x420d0000 0x118>;
            ngpios = <32>;
            #gpio-cells = <2>;
            status = "okay";
            debounce = <0>;
            port = <0>;
        };
        gpio32: gpio@420b0004 {
            compatible = "airoha,air-gpio";
            gpio-controller;
            reg = <0x420b0000 0x44 0x420c0000 0x108 0x420d0000 0x118>;
            ngpios = <26>;
            #gpio-cells = <2>;
            status = "okay";
            debounce = <0>;
            port = <1>;
        };
        pinctrl: pin-controller{
            compatible = "airoha,air-pinctrl";
            status = "okay";
        };
        spim0: spim@421f0000 {
            #address-cells = <1>;
            #size-cells = <0>;
            compatible = "airoha,air-spim";
            reg = <0x421f0000 0x3c>;
            status = "okay";
