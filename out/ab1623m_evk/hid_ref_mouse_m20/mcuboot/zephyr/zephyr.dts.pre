# 42 "/workdir/airoha/mcu/boards/airoha/ab1623m_evk/ab1623m_evk.dts" 2
# 1 "/workdir/airoha/mcu/dts/arm/airoha/ab162x/flash_partitions/dual_slot_with_DFU_2MB.dtsi" 1 3 4
# 37 "/workdir/airoha/mcu/dts/arm/airoha/ab162x/flash_partitions/dual_slot_with_DFU_2MB.dtsi" 3 4
/delete-node/ &main_flash_partitions;

&flash0 {
    reg = <0x08000000 ((2048) * 1024)>;
    main_flash_partitions: partitions {
        compatible = "airoha,air-flash-partitions", "fixed-partitions";
        #address-cells = < 0x1 >;
        #size-cells = < 0x1 >;
        partiton_table: partition@0 {
            label = "partition_table";
            reg = < 0x0 0x1000 >;
            id = < 0x0 >;
            read-only;
            download;
            display_name = "PartitionTable";
        };
        security_header0: partition@1000 {
            label = "secure_hdr0";
            reg = < 0x1000 0x1000 >;
            id = < 0x1 >;
            read-only;
            download;
            display_name = "SecureHdr0";
        };
        factory_data: partition@2000 {
            label = "factory_data";

            reg = <0x2000 0x1000>;
            id = <0x0000000D>;
            read-only;
        };
        boot_partition: partition@3000 {
            label = "bootloader";
            reg = < 0x3000 0x18000 >;
            id = < 0x8 >;
            read-only;
            download;
            display_name = "BootLoader";
        };
        upgrade_info: partition@1B000 {
            label = "upgrade_info";

            reg = <0x1b000 0x1000>;
            id = <0x0000000E>;
        };
        slot0_partition: partition@1C000 {




            label = "image-0";
            reg = <0x1C000 0xED000>;
            id = <0x0000000A>;
            download;
            display_name = "MCU_FW";
        };
        slot1_partition: partition@109000 {
            label = "image-1";
            reg = <0x109000 0xED000>;
            id = <0x0000000B>;
        };
        storage_partition: partition@1f6000 {
            label = "storage";
            reg = < 0x1f6000 0xA000 >;
            id = < 0x18 >;
            download;
            display_name = "NV_Data";
        };
    };
};
