&pinctrl {
 gpio0_default: gpio0_default {
  gpio2{
   pinmux = <(2 << 5 | 1 << 0)>;
   bias-pull-up;
  };
  gpio3{
   pinmux = <(3 << 5 | 1 << 0)>;
  };
  gpio17{
   pinmux = <(17 << 5 | 6 << 0)>;
  };
  gpio18{
   pinmux = <(18 << 5 | 6 << 0)>;
   bias-pull-up;
  };
  gpio46{
   pinmux = <(46 << 5 | 6 << 0)>;
  };
  gpio47{
   pinmux = <(47 << 5 | 6 << 0)>;
   bias-pull-up;
  };
 };

 gpio1_default: gpio1_default {

 };
};
# 45 "/workdir/airoha/mcu/boards/airoha/ab1623m_evk/ab1623m_evk.dts" 2

/ {
    model = "Airoha AB1623M Evaluation Board ";

    chosen {
        zephyr,entropy = &trng;
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart1;
        zephyr,sram = &tcm;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zephyr,settings-partition = &storage_partition;
        zephyr,logging_port = &uart0;
    };
};


&gpio0 {
    pinctrl-0 = <&gpio0_default>;
    pinctrl-1 = <&gpio1_default>;
    pinctrl-names = "default","sleep";
};

zephyr_udc0: &usbd {
    status = "okay";
    compatible = "airoha,air-usbd";
};
# 0 "<command-line>" 2
# 1 "./config/ab162x_evb/mcuboot.overlay" 1


/ {
    chosen {
        zephyr,code-partition = &boot_partition;
    };
};
