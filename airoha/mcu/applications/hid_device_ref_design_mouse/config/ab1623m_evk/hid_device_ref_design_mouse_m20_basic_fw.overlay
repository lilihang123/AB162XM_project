&spim0 {
	frequency = <8000000>;
	status = "okay";
	paw3395: paw3395@0{
		compatible = "pixart,paw3395";
		reg= <0>;
		cpi = <1600>;
		lod = "lift_cut_off_2mm";
		rest_mode = <0>;
		motion_sync = <0>;
		ripple_control = <0>;
		angle_snap = <0>;
		mode = "cord";
		xy_direction = "no_direction_adjustment";
		rest1_period_time = <1>;
		rest2_period_time = <20>;
		rest3_period_time = <160>;
		status = "okay";
	};
};

&uart1 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <0>;
    rbuf-size = <0>;
};
&uart2 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <0>;
    rbuf-size = <0>;
};

&pwm_dma0 {
	led_rgb_frequency = <60>;
	status = "okay";
	channel_polarity = <1 1 1 1>;
	rgb_gpio_channel = <0>;
	rgb0: rgb@0{
		compatible = "airoha,air-rgb";
		reg = <0>;
		gpio_control = <38>;
		gpio_polarity = <1>;
		r_channel = <2>;
		g_channel = <1>;
		b_channel = <3>;
		port = <0>;
		status = "okay";
	};
};

&pinctrl {

	gpio0_default: gpio0_default {
		/** SPI pins for motion sensor */
		gpio19{
			pinmux = <GPIO_19_SPI_MST0_SCK>;
		};
		gpio20{
			pinmux = <GPIO_20_SPI_MST0_MISO>;
			bias-pull-up;
		};
		gpio21{
			pinmux = <GPIO_21_SPI_MST0_MOSI>;
		};
		gpio22{
			pinmux = <GPIO_22_SPI_MST0_CS0>;
			bias-pull-up;
		};

		/** Interrupt pin of motion sensor */
		gpio18{
			pinmux = <GPIO_18_EINT18>;
			bias-pull-up;
		};

		/** Mouse L Key */
		gpio5{
			pinmux = <GPIO_5_EINT5>;
			bias-pull-up;
			debounce = <20>;
		};
		
		/** Mouse R Key */
		gpio6{
			pinmux = <GPIO_6_EINT6>;
			bias-pull-up;
		};

		/** Mouse M Key */
		gpio17{
			pinmux = <GPIO_17_EINT17>;
			bias-pull-up;
		};

		/** Mouse FW Key */
		gpio23{
			pinmux = <GPIO_23_EINT23>;
			bias-pull-up;
		};

		/** Mouse BW Key */
		gpio24{
			pinmux = <GPIO_24_EINT24>;
			bias-pull-up;
		};

		/** DPI Key */
		gpio29{
			pinmux = <GPIO_29_EINT29>;
			bias-pull-up;
		};
		
		/** Report Rate Change Key */
		gpio45{
			pinmux = <GPIO_45_EINT45>;
			bias-pull-up;
		};

		/** Slide Switch BT Mode */
		gpio46{
			pinmux = <GPIO_46_EINT46>;
			bias-pull-up;
		};

		/** Slide Switch Gaming Mode */
		gpio47{
			pinmux = <GPIO_47_EINT47>;
			bias-pull-up;
		};

		/** QDEC Input */
		gpio0{
			pinmux = <GPIO_0_RTC_QDEC_IN0>;
			bias-pull-up;
		};
		
		/** QDEC Input */
		gpio1{
			pinmux = <GPIO_1_RTC_QDEC_IN1>;
			bias-pull-up;
		};

		/** LED/RGB */		
		gpio35{
			pinmux = <GPIO_35_PWM1>;			
		};
		gpio36{
			pinmux = <GPIO_36_PWM2>;
		};
		gpio37{
			pinmux = <GPIO_37_PWM3>;
		};
	};

	gpio1_default: gpio1_default {

	};
};

/* set WDT timeout to 5 second */
&wdt0 {
	timeout-sec = <5>;
};



