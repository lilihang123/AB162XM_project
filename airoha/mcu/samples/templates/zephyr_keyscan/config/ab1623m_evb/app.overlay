&spim0 {
    frequency = <8000000>;
    status = "okay";
	paw3395: paw3395@0{
		compatible = "pixart,paw3395";
		reg= <0>;
		cpi = <1600>;
		lod = "lift_cut_off_1mm";
		rest_mode = <0>;
		motion_sync = <1>;
		ripple_control = <0>;
		angle_snap = <0>;
		mode = "cord";
		xy_direction = "no_direction_adjustment";
		rest1_period_time = <1>;
		rest2_period_time = <20>;
		rest3_period_time = <160>;
		status = "okay";
    };
};

&uart1 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <256>;
    rbuf-size = <512>;
};
&uart2 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <1024>;
    rbuf-size = <2048>;
};

&pinctrl {
    gpio0_default: gpio0_default {
      /** keyscan row out gpio  */
        gpio15{
            pinmux = <GPIO_15_GPIO15_KS_ROW>;
            bias-pull-up;
        };
        gpio16{
            pinmux = <GPIO_16_GPIO16_KS_ROW>;
            bias-pull-up;
        };
        gpio17{
            pinmux = <GPIO_17_GPIO17_KS_ROW>;
            bias-pull-up;
        };

        /** keyscan col in gpio  */
        gpio40{
            pinmux = <GPIO_40_GPIO40_KS_COL>;
            bias-pull-down;
        };
        gpio41{
            pinmux = <GPIO_41_GPIO41_KS_COL>;
            bias-pull-down;
        };
        gpio42{
            pinmux = <GPIO_42_GPIO42_KS_COL>;
            bias-pull-down;
        };
    };
};

