&spim0 {
    frequency = <8000000>;
    status = "okay";
	paw3395: paw3395@0{
		compatible = "pixart,paw3395";
		reg= <0>;
		cpi = <1600>;
		lod = "lift_cut_off_1mm";
		rest_mode = <0>;
		motion_sync = <1>;
		ripple_control = <0>;
		angle_snap = <0>;
		mode = "cord";
		xy_direction = "no_direction_adjustment";
		rest1_period_time = <1>;
		rest2_period_time = <20>;
		rest3_period_time = <160>;
		status = "okay";
    };
};

&uart1 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <256>;
    rbuf-size = <512>;
};
&uart2 {
    status = "okay";
    current-speed = < 0xE1000 >;
    data-bits = <3>;
    stop-bits = <1>;
    parity = <0>;
    tbuf-size = <1024>;
    rbuf-size = <2048>;
};

&pinctrl {
    gpio0_default: gpio0_default {
        gpio23{
            pinmux = <GPIO_23_RTC_QDEC_IN0>;
        };
        gpio24{
            pinmux = <GPIO_24_RTC_QDEC_IN1>;
        };
        gpio25{
            pinmux = <GPIO_25_RTC_QDEC_LED>;
        };
        gpio26{
            pinmux = <GPIO_26_COMP1>;
        };
        gpio27{
            pinmux = <GPIO_27_AUXADC2_SARADC1_AIODIFF0_SADIFF0>;
        };
        gpio28{
            pinmux = <GPIO_28_GPIO28>;
            bias-pull-up;
        };
        gpio4{
            pinmux = <GPIO_4_GPIO4>;
            output-enable;
            output-high;
        };
        gpio5{
            pinmux = <GPIO_5_GPIO5>;
            output-enable;
            output-high;
        };
        gpio6{
            pinmux = <GPIO_6_GPIO6>;
            output-enable;
            output-high;
        };
    };
};

