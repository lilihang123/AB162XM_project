menuconfig PMU
    bool "PMU Driver"
    help
      Include PMU drivers in system config

config AIR_PMU
    bool "Airoha PMU"
    depends on SOC_FAMILY_AIROHA

# ---------------------------------------------------------
if AIR_PMU

config AIR_PMU_VOLT_TYPE
    int "PMU voltage type"
    default 0
    help
      valid values: 0(HQA), 1(DONGLE), 2(GAMING), 3(OFFICE), 4(IOT/others)

config AIR_PMU_RET_VIO18_ENABLE
    bool "PMU ret vio18 enable"
    default n

