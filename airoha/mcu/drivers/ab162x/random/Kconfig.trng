config AIR_ENTROPY_ENABLE
    bool "entropy device"
    select ENTROPY_HAS_DRIVER
    select ENTROPY_GENERATOR


choice RNG_GENERATOR_CHOICE
    prompt "Random generator"
    default AIR_RNG_NONE

# add default choice to avoid build error
config AIR_RNG_NONE
    bool "No Random Generator was implemented"


config AIR_TRNG_ENABLE
    bool "Airoha True Random Number Generator"
    depends on SOC_FAMILY_AIROHA
    help
       The true random number generator (TRNG) is a device that generates random numbers
       from the ring oscillator (RO) outputs.
       Vairous types of ROs are adopted, including hybrid Fibonacci ring oscillator (H-FIRO),
       hybrid ring oscillator (H-RO) and hybrid Galois oscillator (H-GARO).

endchoice # RNG_GENERATOR_CHOICE


if AIR_TRNG_ENABLE




endif # AIR_TRNG_ENABLE
