menuconfig CACHE
    bool "Cache Driver"
    help
      Include cache drivers in system config

config AIR_CACHE
    bool "Airoha Cache Controller"
    select CACHE_MANAGEMENT
    select ARCH_HAS_NOCACHE_MEMORY_SUPPORT
    select INIT_ARCH_HW_AT_BOOT
    select NOCACHE_MEMORY
    select CPU_HAS_DCACHE
    select CPU_HAS_ICACHE
    depends on SOC_FAMILY_AIROHA

if AIR_CACHE

CACHE_CONTROLLER_PATH := $(dt_nodelabel_path,cache_controller)
CACHE_MEMORY_SIZE := $(dt_node_int_prop_int,$(CACHE_CONTROLLER_PATH),cache-memory-size)
ICACHE_LINE_SIZE := $(dt_node_int_prop_int,$(CACHE_CONTROLLER_PATH),icache-line-size)
DCACHE_LINE_SIZE := $(dt_node_int_prop_int,$(CACHE_CONTROLLER_PATH),dcache-line-size)
CACHEABLE_REGION_ALIGNMENT := $(dt_node_int_prop_int,$(CACHE_CONTROLLER_PATH),cacheable-region-alignment)

# Kconfig option of cache
config AIR_CACHE_MEMORY_SIZE
    int
    default $(CACHE_MEMORY_SIZE)

config ICACHE_LINE_SIZE
    int
    default $(ICACHE_LINE_SIZE)

config DCACHE_LINE_SIZE
    int
    default $(DCACHE_LINE_SIZE)

config CACHEABLE_REGION_ALIGNMENT
    int
    default $(CACHEABLE_REGION_ALIGNMENT)


endif # AIR_CACHE
