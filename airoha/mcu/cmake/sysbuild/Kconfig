# included by airoha/boards/arm/{BOARD}/Kconfig.sysbuild

config AIR_SERIES_AB162X
    bool
    default y if (BOARD_QUALIFIERS = "ab1620d") || \
                (BOARD_QUALIFIERS = "ab1620dm") || \
                (BOARD_QUALIFIERS = "ab1623") || \
                (BOARD_QUALIFIERS = "ab1623m") || \
                (BOARD_QUALIFIERS = "ab1625m")

config AIR_SERIES_AB161X
    bool
    default y if (BOARD_QUALIFIERS = "ab1615") || \
                (BOARD_QUALIFIERS = "ab1615m") || \
                (BOARD_QUALIFIERS = "ab1615dm") || \
                (BOARD_QUALIFIERS = "ab1615em") || \
                (BOARD_QUALIFIERS = "ab1616m")

config AIR_COLLECT_FIRMWARE
    bool "collect firmware and modify flash_download.cfg if needed"
    default y if AIR_SERIES_AB162X || AIR_SERIES_AB161X


config AIR_SYSBUILD_CHECK_ENABLE
    bool "check sysbuild result, especially the address defined by the cross core variable"
    depends on AIR_COLLECT_FIRMWARE
    default y if AIR_COLLECT_FIRMWARE && AIR_SERIES_AB162X
    default n

config AIR_FLASH_PARTITION_CHECK_ENABLE
    bool "check the differences in the flash partition across different projects in sysbuild"
    depends on AIR_COLLECT_FIRMWARE
    default y if AIR_COLLECT_FIRMWARE
    default n


config AIR_GEN_FOOTPRINT_DETAIL_ENABLE
    bool "generate detail footprint analysis data in airoha format"
    depends on AIR_COLLECT_FIRMWARE
    default y if AIR_COLLECT_FIRMWARE
    default n

config AIR_GEN_FOOTPRINT_STATISTICS_ENABLE
    bool "generate rough footprint statistics data"
    depends on AIR_COLLECT_FIRMWARE
    default y if AIR_COLLECT_FIRMWARE
    default n

config AIR_GEN_RELEASE_RELATED_ENABLE
    bool "generate flash_download_release.cfg and others release related files for airoha's download tool"
    depends on AIR_COLLECT_FIRMWARE
    default y if AIR_COLLECT_FIRMWARE
    default n





config BOOT_SIGNATURE_KEY_FILE
    default "$(ZEPHYR_MCUBOOT_MODULE_DIR)/private_secure_boot_3k.pem"

choice BOOT_SIGNATURE_TYPE
    default BOOT_SIGNATURE_TYPE_NONE
endchoice