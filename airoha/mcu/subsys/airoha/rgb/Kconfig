config AIR_MIDDLE_RGB
    bool "Airoha Middle RGB service."
    select AIR_PWMDMA
    select AIR_PWM
    select AIR_GPIO

if AIR_MIDDLE_RGB

config AIR_RGB_NUM
    int "Airoha Middle RGB number."
    default 1

config AIR_REAL_TIME_RGB_MINI_COUNT
    int "Airoha Middle REALTIME RGB MINI COUNT."
    default 1

config AIR_RGB_PRIORITY_LEVEL_NUM
    int "Airoha Middle RGB priority level number."
    default 16

config AIR_RGB_RESPONSE
    bool "RGB Response mechanism"
    default y
    help
        Specify RGB Response mechanism. Based on this value, different options will be configured.

choice
    prompt "Select RGB ACK or FIFO configuration"
    default AIR_RGB_REAL_TIME_ACK

config AIR_RGB_REAL_TIME_FIFO
    bool "Enable RGB FIFO configuration"
    depends on AIR_RGB_RESPONSE = n
    help
        This option is enabled when AIR_RGB_RESPONSE is set to ACK RGB RESPONSE.

config AIR_RGB_REAL_TIME_ACK
    bool "Enable RGB ACK configuration"
    depends on AIR_RGB_RESPONSE = y
    help
        This option is enabled when AIR_RGB_RESPONSE is set to NACK RGB RESPONSE.

endchoice

config AIR_RGB_EFFECT_OVERWRITE
    bool "Enable RGB OVERWRITE configuration"
    help
        This option is enabled when AIR_RGB_EFFECT_OVERWRITE is set to OVERWRITE RGB EFFECT.
endif # AIR_MIDDLE_RGB


