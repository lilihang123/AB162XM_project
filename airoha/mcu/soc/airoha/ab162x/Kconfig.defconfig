if SOC_FAMILY_AIROHA

rsource "Kconfig.init_priority"

if SOC_AB1620

if BOARD_AIROHA_AB1620_FPGA
    rsource "Kconfig.defconfig.ab1620_fpga"
endif # BOARD_AIROHA_AB1620_FPGA

endif # SOC_AB1620


if SOC_AB1620D

if BOARD_AIROHA_AB1620D_EVK
    rsource "Kconfig.defconfig.ab1620d_evk"
endif # BOARD_AIROHA_AB1620D_EVK

endif # SOC_AB1620D


if SOC_AB1620DM

if BOARD_AIROHA_AB1620DM_EVK
    rsource "Kconfig.defconfig.ab1620dm_evk"
endif # BOARD_AIROHA_AB1620DM_EVK

endif # SOC_AB1620DM


if SOC_AB1623

if BOARD_AIROHA_AB1623_EVK
    rsource "Kconfig.defconfig.ab1623_evk"
endif # BOARD_AIROHA_AB1623_EVK

endif # SOC_AB1623


if SOC_AB1623M

if BOARD_AIROHA_AB1623M_EVB
    rsource "Kconfig.defconfig.ab1623m_evb"
endif # BOARD_AIROHA_AB1623M_EVB

endif # SOC_AB1623M


if SOC_AB1625M

if BOARD_AIROHA_AB1625M_EVK
    rsource "Kconfig.defconfig.ab1625m_evk"
endif # BOARD_AIROHA_AB1625M_EVK

endif # SOC_AB1625M


config NUM_IRQS
    int
    default 53

config HEAP_MEM_POOL_ADD_SIZE_SOC_LEVEL
    int
    default 8192

config SOC_SERIES_AB162X
    bool

config SOC_SERIES
    string
    default "ab162x"

config SOC
    string
    default "ab162x"

config KERNEL_ENTRY
    string
    default "Reset_Handler"


config KERNEL_INIT_PRIORITY_OBJECTS
    int
    default 10


config CUSTOMISED_INIT_CFG_FILE
    string "customised initial configuration file"
    help
       Please use an aboslute path to specify the configuration file.
       The root directory where AIROHA SDK is located can be referenced using AIR_ROOT_DIR.


# only special load( ex. bootloader or download agent ) should disable this feature
config AIR_SOC_CROSS_CORE_MEMORY_ENABLE
    bool "cross memory buffer for multiple cores accesses"
    default y


# System team recommends using light_assert, which will be hooked into zephyr's __ASSERT/__ASSERT_NO_MSG,
# so no separate BT_ASSERT implementation is needed.
config BT_ASSERT
    bool "Custom Bluetooth assert implementation"
    default n
    help
      Use a custom Bluetooth assert implementation instead of the
      kernel-wide __ASSERT() when CONFIG_ASSERT is disabled.

endif # SOC_FAMILY_AIROHA